# Copy to `.env` (or `.env.local`) and adjust. `docker compose` and
# `python -m dashboard_backend` will auto-load it.

# ---------------------------------------------------------------------------
# Dashboard auth (REQUIRED for /api/vast/* and /api/runs/*)
# ---------------------------------------------------------------------------
# The FastAPI backend rejects mutating endpoints when this is unset.
#  - In production:    set to a long random string (`openssl rand -hex 32`).
#  - In local dev:     set to `disabled` to skip auth entirely (a warning is
#                      logged once on first hit so it shows up in operator logs).
# The browser UI must present the SAME value via `localStorage["cascade_api_key"]`
# or `window.CASCADE_API_KEY` (the Settings drawer in the dashboard writes it).
CASCADE_API_KEY=disabled

# ---------------------------------------------------------------------------
# Vast.ai credentials (REQUIRED to see offers / launch runs)
# ---------------------------------------------------------------------------
# Get from https://cloud.vast.ai/cli/   (click "Show CLI Command" → copy the
# value after `--api-key`).  Either set the env var here OR run
# `vastai set api-key <YOUR_KEY>` which writes it to ~/.config/vastai/vast_api_key.
VAST_API_KEY=

# Where the controller stores its Vast.ai CLI config inside the docker
# container.  Usually a mounted host dir.
VASTAI_CONFIG_DIR=~/.config/vastai

# ---------------------------------------------------------------------------
# SSH key for reaching the provisioned VPS (REQUIRED to launch runs)
# ---------------------------------------------------------------------------
# The public half must be added to your Vast.ai account at
# https://cloud.vast.ai/account/ → "SSH keys".  The private half lives at
# VAST_SSH_KEY_PATH (path inside the controller process).
#
# Linux/macOS:   VAST_SSH_KEY_PATH=$HOME/.ssh/id_ed25519
# Windows:       VAST_SSH_KEY_PATH=C:/Users/<you>/.ssh/id_ed25519
# Docker:        bind-mount your host's ~/.ssh into /root/.ssh read-only and
#                set VAST_SSH_KEY_PATH=/root/.ssh/id_ed25519
SSH_KEY_DIR=~/.ssh
VAST_SSH_KEY_PATH=

# ---------------------------------------------------------------------------
# Orchestrator container (optional; defaults below)
# ---------------------------------------------------------------------------
CASCADE_ORCH_IMAGE=ghcr.io/twaite11/cascade-orchestrator:latest

# ---------------------------------------------------------------------------
# Dashboard scoring thresholds (optional)
# ---------------------------------------------------------------------------
DASH_MIN_IPTM=0.85
DASH_MIN_AF2_IG=0.80
DASH_MAX_ON_DISTANCE=12.0

# ---------------------------------------------------------------------------
# Reproducibility (optional)
# ---------------------------------------------------------------------------
# Used by scripts/utils/determinism.resolve_seed when no --seed CLI flag is
# passed.  Default is 42.
# CASCADE_SEED=42

# Skip the Protenix MSA pass even on the base model tier (saves GPU time on
# machines without a seqres DB).  Set to 1/true/yes.
# CASCADE_DISABLE_MSA=
