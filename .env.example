# Copy to `.env` and adjust. `docker compose` will auto-load it.

# Orchestrator GPU image (published by .github/workflows/build-orchestrator.yml)
CASCADE_ORCH_IMAGE=ghcr.io/twaite11/cascade-orchestrator:latest

# Vast.ai config (usually $HOME/.config/vastai)
VASTAI_CONFIG_DIR=~/.config/vastai

# SSH key dir bound into the controller (read-only). Must contain the pubkey
# you added to Vast.ai account settings so asyncssh can reach the VPS.
SSH_KEY_DIR=~/.ssh
VAST_SSH_KEY_PATH=/root/.ssh/id_ed25519

# Dashboard thresholds (optional)
DASH_MIN_IPTM=0.85
DASH_MIN_AF2_IG=0.80
DASH_MAX_ON_DISTANCE=12.0
