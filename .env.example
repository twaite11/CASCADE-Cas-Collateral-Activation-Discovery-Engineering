# Copy this file to `.env` at the repo root and fill in REAL values there.
#
# SECURITY: Never paste API keys or private key paths INTO this template file,
# commit that file, or push secrets to GitHub.  `.env` is gitignored locally;
# `.env.example` stays in the repo with placeholders only.

# ---------------------------------------------------------------------------
# Dashboard auth (REQUIRED for /api/vast/* and /api/runs/*)
# ---------------------------------------------------------------------------
# In production: set to a long random string (`openssl rand -hex 32`).
# In local dev:  set to `disabled` to skip auth (one-time warning logged).
# Browser UI:    localStorage.setItem("cascade_api_key", "disabled") must match.
CASCADE_API_KEY=disabled

# ---------------------------------------------------------------------------
# Vast.ai credentials (REQUIRED to see offers / launch runs)
# ---------------------------------------------------------------------------
# Get from https://cloud.vast.ai/cli/ (hex string after --api-key), or run:
#   vastai set api-key <YOUR_KEY>
# Prefer putting the real key only in `.env`, not here.
VAST_API_KEY=

# Where the CLI stores config (inside Docker mounts this as a volume).
VASTAI_CONFIG_DIR=~/.config/vastai

# ---------------------------------------------------------------------------
# SSH *private key file* for connecting to rented instances (REQUIRED to launch)
# ---------------------------------------------------------------------------
# This must be an absolute filesystem path to your PRIVATE key, e.g.:
#   Windows: VAST_SSH_KEY_PATH=C:/Users/you/.ssh/id_ed25519
#   Linux:   VAST_SSH_KEY_PATH=/home/you/.ssh/id_ed25519
# Register only the matching .pub in https://cloud.vast.ai/account/ (SSH keys).
# Do NOT paste the `ssh-ed25519 AAAA...` line here—that is NOT a path.
SSH_KEY_DIR=~/.ssh
VAST_SSH_KEY_PATH=

# Push/pull to Vast instances prefers ``rsync``, then falls back to OpenSSH ``scp``
# (scp.exe ships with Windows OpenSSH Client). Override if auto-detect is wrong:
# CASCADE_SYNC_BIN=C:/tools/cwRsync/bin/rsync.exe

# ---------------------------------------------------------------------------
# Optional: point Vite's dev proxy at a non-default API port if needed.
# Default in vite.config.ts is http://localhost:8001
# CASCADE_API_URL=http://localhost:8001

# ---------------------------------------------------------------------------
CASCADE_ORCH_IMAGE=ghcr.io/twaite11/cascade-orchestrator:latest

DASH_MIN_IPTM=0.85
DASH_MIN_AF2_IG=0.80
DASH_MAX_ON_DISTANCE=12.0

# CASCADE_SEED=42
# CASCADE_DISABLE_MSA=
